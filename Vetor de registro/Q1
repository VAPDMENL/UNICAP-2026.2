#include <stdio.h>
#include <string.h>

struct registro {
    int codigo;
    char nome[40];
    char descricao[40];
    float valor;
    int quantidade;
};

int total = 0;
int cadastro(struct registro c[40], int *total);
int modificar(struct registro c[40]);
int estoque1(struct registro c[40]);
int estoque2(struct registro c[40]);
int vendas(struct registro c[40]);
int estoque_Zero(struct registro c[40]);
int estoque_Total(struct registro c[40]);

int main(void) {
    struct registro estoque[40];
    printf("Digite: [cadastro] para realizar o cadastro. \n"
            "Digite: [modificar] para realizar uma alteração no banco de dados. \n"
            "Digite: [valor] para ver o valor de um item. \n"
            "Digite: [quantidade] para ver a quantidade de um item. \n"
            "Digite: [comprar] para comprar algum item. \n"
            "Digite: [atualizar] para atualizar o estoque. \n"
            "Digite: [estoque1] para ver o relatório de estoque. \n"
            "Digite: [esotque0] para ver o relatório de itens sem estoque. \n");
    int AR = 0;
    while (AR == 0){
        char entrada[10];
        scanf("%s", entrada);
        if (strcmp(entrada, "cadastro")==0){
            cadastro(estoque, &total);
        }else if (strcmp(entrada, "comprar")==0){
            vendas(estoque);
        }
        }
}

int cadastro(struct registro c[40], int *total) {
    if (*total >= 40){
        printf("Limite de cadastros alcançado.");
    } else{
    int i = *total;
    printf("Insira o código do objeto a ser cadastrado");
    scanf("%d", &c[i].codigo);
    printf("Insira o nome do objeto");
    scanf(" %39[^\n]", c[i].nome);
    printf("Insira a descrição do produto");
    scanf(" %39[^\n]", c[i].descricao);
    printf("Insira o valor do produto");
    scanf("%f", &c[i].valor);
    printf("Insira a quantidade do produto");
    scanf("%d", &c[i].quantidade);
    (*total)++;
    }
    return 1;
}

int modificar(struct registro c[40]){
    printf("Digite o código do item a ser modificado");
    int i=0;
    while (i>=0 && i<total){
        if ("%d" == c[i].codigo){
            printf("Insira o número de unidades.");
            scanf("%d", &c[i].quantidade);
            i = -1;
    }
        else{
            (i++);
        }
    }
    return 1;
}

int estoque1(struct registro c[40]) {
    printf("Insira o código de produto:");
    for(int i=0; i<total; i++){
        if ("%d" == c[i].codigo){
            printf("O produto possui o valor de: %2.f\n", c[i].valor);
        } else {printf("Produto não encontrado.");}
        
        return  1;
    }
}

int estoque2(struct registro c[40]) {
    printf("Insira o código de produto:");
    for(int i=0; i<total; i++){
        if ("%d" == c[i].codigo){
            printf("O produto possui um estoque de:", c[i].quantidade);
        }else {printf("Produto não encontrado.");}
        
        return  1;
    }
}


int vendas(struct registro c[40]) {
    printf("Diga o código do produto vendido:");
    for (int i=0; i<total; i++) {
        if ("%d" == c[i].codigo){
            printf("Diga a quantidade desejada:");
            int quantidadeAlvo;
            scanf("%d", &quantidadeAlvo);
                if (c[i].quantidade >= quantidadeAlvo){
                    printf("Venda realizada com sucesso.", quantidadeAlvo, "itens por", quantidadeAlvo*c[i].valor);
                    c[i].quantidade = c[i].quantidade - quantidadeAlvo;
            }   else {printf("Não há estoque suficiente.");}
                return 1;
        }else {
            printf("Produto não encontrado.");
        }
        
        return 1;
    }
    }

int estoque_Total(struct registro c[40]){
    for (int i = 0; i<total; i++){
        printf(c[i].codigo, c[i].descricao);
    }
}

int estoque_Zero(struct registro c[40]){
    for (int i = 0; i<total; i++){
        if (c[i].quantidade == 0) {
            printf("Código: %d | Descrição: %s\n", c[i].codigo, c[i].descricao);
        }
    }
}